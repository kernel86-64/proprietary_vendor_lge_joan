firmware_directories /vendor/firmware/

# DRM / GPU (msm + freedreno)
/dev/dri/*                0666   system     graphics

# Modem remote filesystem shared memory
/dev/qcom_rmtfs_mem*      0660   system     system

# Input (touch, keys, haptics)
/dev/input/*              0660   root       input

# Backlight
/sys/class/backlight/*    brightness       0664   system   system
/sys/class/leds/*         brightness       0664   system   system

# Bluetooth HAL unblocks the controller through rfkill
/dev/rfkill               0660   bluetooth  bluetooth
/sys/class/rfkill/rfkill* state  0664 bluetooth bluetooth

# NFC (PN548)
/dev/pn54x                0660   nfc        nfc

# Camera (CAMSS media graph, sensor subdevices)
/dev/media*               0660   system     camera
/dev/v4l-subdev*          0660   system     camera
/dev/video*               0660   system     camera

/dev/kgsl-3d0 0666 system graphics
/dev/ion 0666 system graphics
