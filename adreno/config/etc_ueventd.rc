firmware_directories /vendor/firmware/

# DRM / GPU (msm + freedreno)
/dev/dri/*                0666   system     graphics

# Modem remote filesystem shared memory
/dev/qcom_rmtfs_mem*      0660   system     system

# Input (touch, keys, haptics)
/dev/input/*              0660   root       input

# Backlight
/sys/class/backlight/*    brightness       0664   system   system
/sys/class/leds/*         brightness       0664   system   system
# The camera HAL (cameraserver, group camera) drives the flash LED.
/sys/class/leds/white:flash brightness      0664   system   camera

# Bluetooth HAL unblocks the controller through rfkill
/dev/rfkill               0660   bluetooth  bluetooth
/sys/class/rfkill/rfkill* state  0664 bluetooth bluetooth

# NFC (PN548)
/dev/pn54x                0660   nfc        nfc

# Camera (CAMSS media graph, sensor subdevices)
/dev/media*               0660   system     camera
/dev/v4l-subdev*          0660   system     camera
/dev/video*               0660   system     camera

# Sensors (qcom-smgr IIO devices on the SLPI QRTR node, read by the sensors
# multihal as system). ueventd globs do not cross "/", so spell out the path.
/dev/iio:device*          0660   system     system
/sys/devices/platform/soc@0/5800000.remoteproc/remoteproc/remoteproc*/5800000.remoteproc:glink-edge/5800000.remoteproc:glink-edge.IPCRTR.-1.-1/9-*/iio:device* buffer/enable                    0664 system system
/sys/devices/platform/soc@0/5800000.remoteproc/remoteproc/remoteproc*/5800000.remoteproc:glink-edge/5800000.remoteproc:glink-edge.IPCRTR.-1.-1/9-*/iio:device* buffer/length                    0664 system system
/sys/devices/platform/soc@0/5800000.remoteproc/remoteproc/remoteproc*/5800000.remoteproc:glink-edge/5800000.remoteproc:glink-edge.IPCRTR.-1.-1/9-*/iio:device* scan_elements/in_accel_x_en      0664 system system
