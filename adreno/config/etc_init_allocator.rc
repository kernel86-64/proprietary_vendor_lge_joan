service vendor.graphics.allocator /vendor/bin/hw/android.hardware.graphics.allocator@2.0-service
    class hal animation
    interface android.hardware.graphics.allocator@2.0::IAllocator default
    user system
    group graphics drmrpc
    seclabel u:r:su:s0
    capabilities SYS_NICE
    onrestart restart surfaceflinger
